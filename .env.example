# Variáveis de ambiente do Orçaí.
# Desenvolvimento: copie para .env.local e preencha. Produção (Vercel): cadastre em
# Project Settings → Environment Variables. Nunca commite arquivos .env com valores.

# URL do projeto Supabase (Supabase → Project Settings → Data API). Pública.
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável do Supabase (Project Settings → API Keys → Publishable key). Pública:
# a segurança vem do RLS no banco. O projeto NÃO usa a service role key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço público do site, sem barra no fim, usado nos links enviados aos clientes
# (orçamento, WhatsApp) e no e-mail de confirmação. Ex.: https://orcai.vercel.app
# Vazio no desenvolvimento = http://localhost:3000. Para testar no celular pelo Wi-Fi,
# use o IP do computador: http://192.168.0.10:3000
NEXT_PUBLIC_SITE_URL=

# Chave da API do Google Gemini para o "Montar com IA" (grátis em
# https://aistudio.google.com/apikey). SECRETA: só no servidor, nunca com NEXT_PUBLIC_.
# Vazia = a IA aparece desativada e o resto do app funciona.
GEMINI_API_KEY=

# Opcional: modelo do Gemini (padrão: gemini-3.5-flash-lite).
GEMINI_MODEL=
