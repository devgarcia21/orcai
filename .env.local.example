# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API Keys / Data API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Endereço do app, usado para montar os links enviados aos clientes (sem barra no fim).
# Para abrir no celular na mesma rede Wi-Fi, use o IP do computador: http://192.168.0.10:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IA "Montar com IA" (Google Gemini, plano gratuito). Só no servidor: NUNCA use NEXT_PUBLIC.
# Crie a chave grátis em https://aistudio.google.com/apikey. Sem chave, a IA aparece desativada.
GEMINI_API_KEY=
# Opcional: modelo do Gemini (padrão: gemini-3.5-flash-lite)
GEMINI_MODEL=
